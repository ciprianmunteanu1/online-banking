# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onlinebanking?schema=public"

# JWT
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me"
JWT_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"

# Encryption (for card numbers — 32 hex chars = 128-bit key)
ENCRYPTION_KEY="a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6"

# App
PORT=3000
FRONTEND_URL="http://localhost:5173"

# Step-up Auth
STEP_UP_THRESHOLD_AMOUNT=5000
